MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=
PORT=3001

# --- Nuevo: QR ---
# external_pos_id de tu Caja (POS). Se obtiene corriendo una vez:
#   cd server && npm run setup:qr
MP_QR_EXTERNAL_POS_ID=

# --- Nuevo: Point / Smart Point ---
# id de tu terminal (ej: NEWLAND_N950__SBX0000001). Se obtiene con:
#   GET /api/payments/point/terminals
MP_POINT_TERMINAL_ID=

# --- Nuevo: Webhooks ---
# Firma secreta que Mercado Pago genera al configurar la URL de notificaciones
# en el panel (Tus integraciones > tu app > Webhooks > Configurar notificaciones).
# Sin esto, el server NO valida que los webhooks de Point/Checkout sean reales.
MP_WEBHOOK_SECRET=

# --- Nuevo: moneda por defecto usada en las órdenes QR/Point ---
MP_CURRENCY=CLP
